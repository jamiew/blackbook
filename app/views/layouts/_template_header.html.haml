%head
  %meta{ http_equiv_attrs }
  %meta{ 'http-equiv' => 'imagetoolbar', content: 'no' }
  %meta{ name: 'distribution', content: 'all' }
  %meta{ name: 'robots', content: @noindex ? 'noindex,follow' : 'all' }
  %meta{ name: 'resource-type', content: 'document' }
  %meta{ name: 'MSSmartTagsPreventParsing', content: 'true' }

  -# How a client finds the API without reading the site. `service-desc` is the
  -# machine-readable description (RFC 8631), `describedby` the prose one.
  %link{ rel: 'service-desc', type: 'application/yaml', href: '/openapi.yaml', title: 'OpenAPI' }
  %link{ rel: 'describedby', type: 'text/plain', href: '/llms.txt', title: 'llms.txt' }

  = stylesheet_link_tag 'application', media: 'all'
  -# Propshaft doesn't read sprockets `//= require` directives, so each file is listed here.
  -# `rails-ujs` ships with actionview and drives data-method/data-confirm on links.
  = javascript_include_tag 'rails-ujs', 'application'
  = csrf_meta_tags

  = yield :head

  %title= page_title

