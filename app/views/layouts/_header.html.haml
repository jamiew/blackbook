- alt = '#000000book: An open database for Graffiti Markup Language (GML) files'
%header.masthead.shell
  %a.masthead__logo{ href: root_path, 'aria-label' => alt }
    = image_tag('/images/logo/clean.png', alt: alt, data: { logo_default: true, original: '/images/logo/clean.png' })

  %nav.masthead__nav{ 'aria-label' => 'Primary' }
    = nav_link 'data', tags_path, active: %w[tags favorites]
    = nav_link 'applications', visualizations_path, active: %w[visualizations]
    = nav_link 'API/docs', docs_path, active: %w[docs]
    = nav_link 'about', about_path
    = nav_link 'upload', upload_path, css: 'masthead__upload'

  .masthead__account.meta
    - if @browse
      -# Try the site in another skin. player.js remembers the choice per browser.
      .masthead__view{ role: 'group', 'aria-label' => 'Theme', data: { theme_switch: true } }
        - %w[ink paper acid].each do |name|
          %button{ type: 'button', data: { theme: name }, 'aria-pressed' => (name == 'ink').to_s }= name
      .masthead__view{ role: 'group', 'aria-label' => 'Chrome', data: { chrome_switch: true } }
        - %w[full quiet bare].each do |name|
          %button{ type: 'button', data: { chrome: name }, 'aria-pressed' => (name == 'full').to_s }= name
    - if current_user
      %a{ href: user_path(current_user) }= image_tag(attachment_url(current_user, :photo, :tiny), alt: current_user.login)
      = link_to 'settings', settings_path
      = link_to 'logout', logout_path, class: 'logout'
    - else
      = link_to 'login', login_path
      = link_to 'signup', signup_path
