.page__head
  %div
    %span.eyebrow The archive
    %h1.page__title Applications
    %p.page__lede Capture apps, players and toys that write or read GML. Register yours and it appears here once approved.
  %p.page__lede.meta= pluralize(number_with_delimiter(@visualizations.total_entries), 'app')

.filters
  .filters__spacer
  = link_to '+ Register an application', new_visualization_path, class: 'button button--solid'

- if @visualizations.empty?
  %p.page__lede None yet.
- else
  .tag-grid
    - @visualizations.each do |app|
      %a.tag-card{ href: visualization_path(app) }
        .tag-card__frame
          -# Only admins are served unapproved apps, so this is a moderation cue.
          - unless app.approved?
            %span.tag-card__id Pending
          = image_tag attachment_url(app, :image, :medium), alt: app.name, loading: 'lazy'
        .tag-card__body
          %span.tag-card__title= app.name
          %span.tag-card__app= [app.kind_name.presence, app.authors.presence].compact.join(' · ')

  %nav{ 'aria-label' => 'Pagination', style: 'margin-top: 28px' }
    = pagination(@visualizations)
