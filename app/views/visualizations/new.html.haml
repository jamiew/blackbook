.page__head
  %div
    %p.crumb= link_to '← All applications', visualizations_path
    %h1.page__title Register an application
    %p.page__lede Something that writes or reads GML. It goes live once an admin approves it.

.form-page
  = render 'layouts/error_messages', target: @visualization
  = form_for @visualization, html: { multipart: true } do |f|
    = render 'form', f: f
    %p.actions= f.submit 'Register'
