- can_edit = is_owner?(@visualization) || is_admin?
- content_for :description, "#{@visualization.name}: #{@visualization.description.to_s.truncate(150)}"
- if @visualization.image.attached?
  - content_for :og_image, attachment_url(@visualization, :image, :large)
  - content_for :og_image_alt, "#{@visualization.name}, screenshot"
- content_for :structured_data, json_ld(app_structured_data(@visualization))
- null = content_tag(:span, 'null', class: 'specs__value--null')

.page__head
  %div
    %p.crumb= link_to '← All applications', visualizations_path
    %h1.page__title
      = @visualization.name
      - unless @visualization.version.blank?
        %span.meta= @visualization.version
    %p.page__lede.meta= [@visualization.kind_name.presence, @visualization.authors.presence].compact.join(' · ')

  - if is_admin?
    .actions
      - if @visualization.approved?
        = link_to 'Unapprove', unapprove_visualization_path(@visualization), method: :put, class: 'button button--quiet', data: { confirm: 'Unapprove this app?' }
      - else
        = link_to 'Approve', approve_visualization_path(@visualization), method: :put, class: 'button button--solid'

- if @sample
  -# The newest tag in the archive made with this app.
  = render 'tags/player', tag: @sample, link: true

- if @visualization.image.attached?
  %figure.figure
    = image_tag attachment_url(@visualization, :image, :large), alt: @visualization.name
- unless @visualization.description.blank?
  %p.page__lede{ style: 'margin-top: 20px; max-width: 68ch' }= @visualization.description

.specs
  .specs__row
    %span.specs__key Authors
    %span.specs__value= @visualization.authors.presence || null
  .specs__row
    %span.specs__key Website
    %span.specs__value= website_link(@visualization.website) || null
  .specs__row
    %span.specs__key Source code
    %span.specs__value= website_link(@visualization.source_url) || content_tag(:span, 'closed', class: 'specs__value--null')
  - unless @visualization.kind_name.blank?
    .specs__row
      %span.specs__key Language
      %span.specs__value= @visualization.kind_name
  - unless @visualization.download.blank?
    .specs__row
      %span.specs__key Download
      %span.specs__value= website_link(@visualization.download)
  - if @visualization.user
    .specs__row
      %span.specs__key Submitter
      %span.specs__value= link_to @visualization.user.login, user_path(@visualization.user)
  .specs__row
    %span.specs__key Submitted
    %span.specs__value= @visualization.created_at.strftime('%Y-%m-%d')
  - if @visualization.approved?
    .specs__row
      %span.specs__key Approved
      %span.specs__value
        = @visualization.approved_at.strftime('%Y-%m-%d')
        - if is_admin? && @visualization.approver
          == by #{link_to @visualization.approver.login, user_path(@visualization.approver)}
  - elsif is_admin?
    .specs__row
      %span.specs__key Approved
      %span.specs__value.specs__value--null pending

- if can_edit
  .modbox
    %h2 Modbox
    .modbox__body
      = link_to 'Edit', edit_visualization_path(@visualization), class: 'button button--quiet'
      = link_to 'Delete', visualization_path(@visualization), method: :delete, class: 'button button--danger', data: { confirm: 'Delete this application?' }
