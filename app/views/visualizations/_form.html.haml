-# Shared by new and edit. `f` is the form builder for @visualization.
%fieldset
  %legend Application
  %p
    %label{ for: 'visualization_name' }== Name #{redstar}
    = f.text_field :name
  %p
    %label{ for: 'visualization_version' } Version
    = f.text_field :version
  %p
    %label{ for: 'visualization_kind' } Language
    = f.select :kind, Visualization::KINDS

%fieldset
  %legend People
  -# new and create sit behind require_user, so current_user is always there.
  - if @visualization.new_record?
    %p.meta== Submitting as #{current_user.login}
  - elsif @visualization.user
    %p.meta== Submitted by #{@visualization.user.login}
  %p
    %label{ for: 'visualization_authors' }== Authors #{redstar}
    = f.text_area :authors, rows: 2
  %p
    %label{ for: 'visualization_website' } Website
    = f.text_field :website, placeholder: 'https://'
  %p
    %label{ for: 'visualization_source_url' } Source code, if it is open
    = f.text_field :source_url, placeholder: 'https://github.com/'

%fieldset
  %legend About
  %p
    %label{ for: 'visualization_description' }== What it does #{redstar}
    = f.text_area :description, rows: 6
  %p
    %label{ for: 'visualization_image' } Screenshot (JPG, PNG or GIF under 1 MB)
    = f.file_field :image, accept: 'image/jpeg,image/png,image/gif'
    - if @visualization.image.attached?
      = image_tag attachment_url(@visualization, :image, :small), alt: '', style: 'margin-top: 8px'

%fieldset
  %legend Embedding
  %p.check
    = f.check_box :is_embeddable, id: 'embeddable_toggle'
    %label{ for: 'embeddable_toggle' } This app can be embedded on a tag page
  .embed_details{ class: @visualization.is_embeddable ? '' : 'disabled' }
    %p
      %label{ for: 'visualization_embed_url' }== URL to the .swf, .js or page #{redstar}
      = f.text_field :embed_url
    %p
      %label{ for: 'visualization_embed_callback' } Callback function, for example drawGML
      = f.text_field :embed_callback
    %p
      %label{ for: 'visualization_embed_params' } Extra parameters, foo=bar&bob=joe
      = f.text_field :embed_params
    %p
      %label{ for: 'visualization_embed_code' } Embed code (see the API docs)
      = f.text_area :embed_code, rows: 3

:javascript
  document.addEventListener('DOMContentLoaded', function () {
    var toggle = document.getElementById('embeddable_toggle');
    var details = document.querySelector('.embed_details');

    function syncEmbedDetails() {
      details.classList.toggle('disabled', !toggle.checked);
      details.querySelectorAll('input, textarea, select').forEach(function (field) {
        field.disabled = !toggle.checked;
      });
    }

    toggle.addEventListener('change', syncEmbedDetails);
    syncEmbedDetails();
  });
