.page__head
  %div
    %span.eyebrow= link_to "← #{@visualization.name}", visualization_path(@visualization)
    %h1.page__title Edit application

.form-page
  = render 'layouts/error_messages', target: @visualization
  = form_for @visualization, html: { multipart: true } do |f|
    = render 'form', f: f
    %p.actions
      = f.submit 'Save'
      = link_to 'Cancel', visualization_path(@visualization), class: 'button button--quiet'
