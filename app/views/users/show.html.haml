- @user ||= current_user

.page__head
  %div
    %span.eyebrow Writer
    %h1.page__title= @user.login
    - unless @user.tagline.blank?
      %p.page__lede= @user.tagline
  %ul.instruments{ style: 'border: 0; gap: 0' }
    %li.instrument
      %span.instrument__label Tags
      %span.instrument__value= link_to @user.tags.count, user_tags_path(@user)
    %li.instrument
      %span.instrument__label Favorites
      %span.instrument__value= @user.favorites.count
    %li.instrument
      %span.instrument__label Joined
      %span.instrument__value== #{timeago(@user.created_at)} ago
    - if @user.admin?
      %li.instrument
        %span.instrument__label Role
        %span.instrument__value Admin

.profile
  %div
    - if @tags.blank?
      %p.page__lede Nothing uploaded yet.
    - else
      .section-head
        %h2 Uploaded tags
        %span.meta= "#{number_with_delimiter(@tags.total_entries)} total"
      .tag-grid
        = render partial: 'tags/tag', collection: @tags, as: :tag
      %nav{ 'aria-label' => 'Pagination', style: 'margin-top: 24px' }
        = pagination(@tags)

  %aside.profile__aside
    .hero__panel
      %h2 Profile
      %p.profile__photo= link_to image_tag(attachment_url(@user, :photo, :small), alt: @user.login), attachment_url(@user, :photo, :medium)
      - unless @user.website.blank?
        %p= link_to @user.website.gsub(%r{^https?://}, ''), (@user.website =~ /^http/ ? @user.website : "http://#{@user.website}"), rel: 'nofollow'
      - unless @user.about.blank?
        %p{ style: 'color: var(--dim); font-size: 14px' }= @user.about
      - unless @user.iphone_uniquekey.blank?
        %p.meta Paired with a device
      - if current_user == @user
        %p= link_to 'Edit settings', settings_path, class: 'button'

    - unless @notifications.blank?
      .hero__panel
        %h2 Activity
        = render partial: 'home/notifications', object: @notifications
