.page__head
  %div
    %span.eyebrow The archive
    %h1.page__title Writers
  %p.page__lede.meta= "#{number_with_delimiter(@users.total_entries)} accounts"

%ul.people
  - @users.each do |user|
    -# Old records can fail to_param, so fall back to the raw id.
    - link = (user_path(user) rescue user_path(id: user.to_param))
    %li
      %a.person{ href: link }
        = image_tag attachment_url(user, :photo, :small), alt: user.login
        %span.person__name= user.login
        %span.person__meta.meta
          - count = user.tags.count
          = count.positive? ? pluralize(count, 'tag') : 'no tags'
          - unless user.iphone_uniquekey.blank?
            = '· paired'

%nav{ 'aria-label' => 'Pagination', style: 'margin-top: 28px' }
  = pagination
