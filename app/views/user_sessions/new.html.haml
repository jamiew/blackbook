#login.signup_or_login.user_form.quarter.centered

  = form_with url: user_session_path, method: :post do |f|

    %h1 Login
    = f.label :login, 'Username'
    = f.text_field :login, value: params[:login]

    = f.label :password, 'Password'
    = f.password_field :password

    %br
    .buttons
      = f.submit "Login"

    .help
      %ol.square
        %li= link_to 'no account? signup here', signup_path, class: 'signup'
        %li= link_to 'forgot your password?', forgot_password_path, class: 'forgotten_password'
