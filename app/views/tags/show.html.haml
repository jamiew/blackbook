.page__head
  %div
    %span.eyebrow
      = link_to '← All data', @user ? user_tags_path(@user) : tags_path
    %h1.tag-detail__id= tag_title(@tag)
    %p.page__lede.meta
      = application_link(@tag.sexy_app_name)
      = '·'
      = tag_user_link(@tag)
      = '·'
      %abbr{ title: @tag.created_at.strftime('%D %T') }== #{timeago(@tag.created_at)} ago

  .stepper
    - if @next
      = link_to '← Next', tag_path(@next), class: 'button button--quiet'
    - if @prev
      = link_to 'Previous →', tag_path(@prev), class: 'button button--quiet'
    - on = (current_user && @tag.favorited_by?(current_user)) || false
    = link_to (on ? '★ Favorited' : '☆ Favorite'), tag_favorites_path(@tag), method: 'post', class: "button #{'button--solid' if on}"

.tag-detail
  %div
    = render partial: 'tags/player', object: @tag, as: :player

  %aside
    .specs
      .specs__row
        %span.specs__key Application
        %span.specs__value
          - app = @tag.gml_application.presence || @tag.application
          = app.blank? ? content_tag(:span, 'null', class: 'specs__value--null') : application_link(@tag.sexy_app_name)
      .specs__row
        %span.specs__key Keywords
        %span.specs__value
          - if @tag.gml_keywords.blank?
            %span.specs__value--null null
          - else
            = @tag.gml_keywords.split(',').map { |w| link_to w.strip, tags_path(keywords: w.strip) }.join(', ').html_safe
      - unless @tag.author.blank?
        .specs__row
          %span.specs__key Author
          %span.specs__value= @tag.author
      .specs__row
        %span.specs__key Uploader
        %span.specs__value= tag_user_link(@tag)
      .specs__row
        %span.specs__key Location
        %span.specs__value
          = @tag.location.blank? ? content_tag(:span, 'null', class: 'specs__value--null') : location_link(@tag.location)
      - unless @tag.description.blank?
        .specs__row
          %span.specs__key Description
          %span.specs__value= @tag.description
      .specs__row
        %span.specs__key Uploaded
        %span.specs__value= @tag.created_at.strftime('%Y-%m-%d %H:%M:%S')
      -# There is no :original variant, so this links the stored blob itself.
      - url = @tag.image.attached? ? url_for(@tag.image) : @tag.remote_image
      - if url
        .specs__row
          %span.specs__key Still
          %span.specs__value= link_to File.basename(url.gsub(/\?.*/, '')), url, target: '_blank', rel: 'noopener'

    %p{ style: 'margin: 14px 0 0; display: flex; gap: 8px; flex-wrap: wrap' }
      = link_to 'Download GML', tag_path(@tag, format: :gml), class: 'button button--solid'
      = link_to 'What is GML?', 'http://fffff.at/gml-week-graffiti-markup-language/', class: 'button button--quiet', target: '_blank', rel: 'noopener'

    -# Fetched when the disclosure is first opened rather than inlined. A busy
    -# tag's GML runs to several hundred kilobytes, which was the great bulk of
    -# this page's weight for something most visitors never unfold.
    %details.source{ data: { source_url: tag_path(@tag, format: :gml) } }
      %summary Source
      %textarea{ rows: 14, readonly: true, onclick: 'this.select();', 'aria-label' => 'GML source',
                 placeholder: 'Loading…' }

    - if is_owner?(@tag) || is_admin?
      .modbox
        %h2 Modbox
        .modbox__body
          = link_to 'Edit', edit_tag_path, class: 'button button--quiet'
          = link_to 'Delete', tag_path, method: 'delete', class: 'button button--danger', data: { confirm: 'Delete this tag?' }
