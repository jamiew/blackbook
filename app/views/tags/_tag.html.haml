-# One cell in the tag grid. The image is the content, so it gets the space.
%a.tag-card{ href: tag_path(tag) }
  .tag-card__frame
    %span.tag-card__id= "##{tag.id}"
    - if tag.image.attached? || tag.remote_thumbnail_url.present?
      = image_tag tag_thumbnail_url(tag), alt: "Tag ##{tag.id}", loading: 'lazy'
    - else
      -# Older uploads never had a still generated. Say so rather than falling
      -# back to a stock photo that reads as the tag itself.
      %span.tag-card__empty No still
  .tag-card__body
    %span.tag-card__app= tag.sexy_app_name.presence || 'Upload'
    %span.tag-card__who
      = tag.user&.login || tag.secret_username || 'anon'
      = '·'
      = "#{timeago(tag.created_at)} ago"
