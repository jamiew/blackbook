-# One cell in the tag grid. The drawing is a canvas that draws the tag once
-# it scrolls into view (gml_thumbnails.js); the still is the capture app's
-# upload, when there was one. Which shows is the grid's display mode, set on
-# <html> by the dropdown on /data. Without JS the still shows.
%a.tag-card{ href: tag_path(tag), 'aria-current' => (local_assigns[:current] == tag ? 'true' : nil) }
  .tag-card__frame
    %span.tag-card__id= "##{tag.id}"
    .tag-card__drawing
      %canvas.tag-card__canvas{ data: { preview: tag_path(tag, format: :json, preview: 1), autoplay: true }, 'aria-label' => "Tag ##{tag.id}" }
    - if tag.image.attached? || tag.remote_thumbnail_url.present?
      = image_tag tag_thumbnail_url(tag), alt: '', class: 'tag-card__still', loading: 'lazy'
  .tag-card__body
    %span.tag-card__app= tag.sexy_app_name.presence || 'Upload'
    %span.tag-card__who
      = tag.user&.login || tag.secret_username || 'anon'
      = '·'
      = "#{timeago(tag.created_at)} ago"
