= auto_discovery_link_tag(:rss, params.merge({ format: :rss }), title: page_title)

.page__head
  %div
    - if @user
      %p.crumb= link_to '← Back to profile', user_path(@user)
      %h1.page__title== #{@user.login}'s #{@favorites ? 'favorites' : 'tags'}
    - elsif @search_context
      %p.crumb= link_to '← Back to all data', tags_path
      %h1.page__title= @search_context[:value]
      %p.page__lede.meta== Filtered by #{@search_context[:key]}
    - else
      %h1.page__title Data
  %p.page__lede.meta== #{number_with_delimiter(@tags.total_entries)} tags

.filters
  - if @applications
    %form{ method: 'get', action: tags_path }
      %label.meta{ for: 'app', style: 'margin: 0' } Filter by app
      = select_tag :app, "<option value=''>All applications</option>".html_safe + options_from_collection_for_select(@applications, 'name', 'name', (CGI.unescape(params[:app].to_s) rescue '')), id: 'app'
      = submit_tag 'Apply', name: nil
  .filters__spacer
  - if current_user
    = link_to '+ Upload GML', new_tag_path, class: 'button button--solid'

- keys = %w[has from who year]
.chips{ role: 'group', 'aria-label' => 'Filter' }
  = filter_chip 'All', keys: keys
  = filter_chip 'With still', { has: 'still' }, keys: keys
  = filter_chip 'From a device', { from: 'device' }, keys: keys
  = filter_chip 'Claimed', { who: 'claimed' }, keys: keys
  = filter_chip 'Anonymous', { who: 'anon' }, keys: keys
  - if @years.to_a.size > 1
    %span.chips__gap
    - @years.each do |year|
      = filter_chip year.to_s, { year: year }, keys: keys

- if @tags.empty?
  %p.page__lede No results.
- else
  = render layout: 'tags/browse', locals: { tag: @tag } do
    .tag-grid
      = render partial: 'tags/tag', collection: @tags, as: :tag, locals: { current: @tag }
    %nav{ 'aria-label' => 'Pagination', style: 'margin-top: 28px' }
      = pagination
