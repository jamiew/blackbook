- content_for :description, "#{@doc.title}. Documentation for the 000000book API and the Graffiti Markup Language."
- content_for :head, tag.link(rel: 'alternate', type: 'text/markdown', href: "#{request.base_url}#{@doc.url_path}.md")
- content_for :structured_data, json_ld(doc_structured_data(@doc))
- sections = { 'api' => 'API', 'gml' => 'GML', 'examples' => 'Examples', nil => 'Running it' }
- pages = DocsPage.all.reject { |p| p.slug == 'README' }.group_by { |p| p.slug.include?('/') ? p.slug.split('/').first : nil }

.docs
  %nav.docs__nav{ 'aria-label' => 'Documentation' }
    %h3= link_to 'Docs', docs_path
    - sections.each do |key, label|
      - next if pages[key].blank?
      %h4.docs__section= label
      %ul
        - pages[key].each do |page|
          %li{ class: ('is-current' if page.slug == @doc.slug) }
            = link_to page.title, page.url_path, 'aria-current' => (page.slug == @doc.slug ? 'page' : nil)

  %article.docs__body
    != @doc.to_html

    %p.docs__source
      = link_to 'Edit this page on GitHub',
        "https://github.com/jamiew/blackbook/blob/main/#{@doc.repo_path}",
        target: '_blank', rel: 'noopener'
