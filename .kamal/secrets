# Kamal reads .kamal/secrets-common first, then this file, and later values win.
# So anything set here overrides secrets-common, including with an empty string
# if the shell variable it references happens to be unset.
#
# KAMAL_REGISTRY_PASSWORD is deliberately NOT listed here. It lives in
# .kamal/secrets-common, which is gitignored, so this repo stays open-source
# without a token in it.

RAILS_MASTER_KEY=$(cat config/master.key)

# Points at the host's MySQL over the Docker bridge. See config/deploy.yml.
DATABASE_URL=$BLACKBOOK_DATABASE_URL
