# Kamal reads .kamal/secrets-common first, then this file, and later values win.
# Cross-file interpolation does NOT work: each file is parsed on its own, so a
# $VAR here reads the shell, not secrets-common, and silently becomes "" when
# the shell does not have it.
#
# So anything whose value lives in the gitignored .kamal/secrets-common must not
# be named here at all. That currently means KAMAL_REGISTRY_PASSWORD and
# DATABASE_URL. This file stays in the repo because it holds no values.

RAILS_MASTER_KEY=$(cat config/master.key)
