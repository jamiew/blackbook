# Kamal reads secrets from here at deploy time. Nothing in this file is a
# literal secret: each line pulls from your shell, your password manager, or an
# env file that is gitignored.
#
# KAMAL_REGISTRY_PASSWORD is a GitHub personal access token with write:packages.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$(cat config/master.key)

# Points at the host's MySQL over the Docker bridge. See config/deploy.yml.
DATABASE_URL=$BLACKBOOK_DATABASE_URL
