# Used by ./deploy and the script/*-production.sh, rehearse-migrations.sh and
# resync-beta.sh scripts. Copy to .env and fill in.
PROD_HOST=your-production-server.com
PROD_USER=deploy
PROD_DB=blackbook_production
PROD_APP_PATH=/var/www/blackbook
LOCAL_DB=blackbook_dev

